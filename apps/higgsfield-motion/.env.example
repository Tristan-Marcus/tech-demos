# Leave unset to use the mock adapter (canvas-rendered clip, no network).
# Set both to route generation through the Higgsfield API instead.
VITE_HF_API_KEY_ID=
VITE_HF_API_KEY_SECRET=

# Optional overrides
# VITE_HF_API_BASE=https://platform.higgsfield.ai   # point at a same-origin proxy if CORS blocks the browser
# VITE_HF_MODEL=higgsfield-ai/dop/standard
